# ══════════════════════════════════════════════════════════════
# Orbit — Environment Configuration
# Copy this file to .env and fill in your values
# ══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────
# Router Connection
# ──────────────────────────────────────────
ROUTER_HOST=192.168.88.1
ROUTER_PORT=8728
ROUTER_USER=readonly
ROUTER_PASSWORD=changeme
ROUTER_USE_SSL=false
ROUTER_NAME=main-router

# WAN interface name (used for traffic monitoring)
# Examples: ether1, pppoe-out1, lte1
# Multiple interfaces separated by comma: ether1,ether2
ROUTER_WAN_INTERFACE=ether1

# ──────────────────────────────────────────
# Data Collection
# ──────────────────────────────────────────
COLLECT_INTERVAL_SECONDS=30

# ──────────────────────────────────────────
# Database
# ──────────────────────────────────────────
# Docker: /data/orbit.db (default, uses named volume)
# Local:  ./data/noc.db
DB_PATH=/data/orbit.db

# How many days of historical data to keep
DATA_RETENTION_DAYS=30

# ──────────────────────────────────────────
# Alert Thresholds
# ──────────────────────────────────────────
ALERT_CPU_THRESHOLD=80
ALERT_RAM_THRESHOLD=85

# ──────────────────────────────────────────
# Application
# ──────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Docker: /logs (default, uses named volume)
# Local:  ./logs
LOG_DIR=/logs

# ──────────────────────────────────────────
# Device Classification
# ──────────────────────────────────────────
# Comma-separated list of IPs to classify as infrastructure
# (servers, VMs). Leave empty if not needed.
# Example: 192.168.1.10,192.168.1.20,192.168.1.30
INFRASTRUCTURE_IPS=

# ──────────────────────────────────────────
# Ubiquiti Access Points (SSH Read-Only)
# ──────────────────────────────────────────
# Format: UBNT_{N}_HOST, UBNT_{N}_USER, UBNT_{N}_PASSWORD, UBNT_{N}_NAME
# N starts at 1. Up to 10 APs supported.
UBNT_1_HOST=192.168.7.251
UBNT_1_USER=ubnt
UBNT_1_PASSWORD=changeme
UBNT_1_NAME=DSC AP 1 RACK

UBNT_2_HOST=192.168.7.250
UBNT_2_USER=ubnt
UBNT_2_PASSWORD=changeme
UBNT_2_NAME=DSC AP 2 INGRESO

UBNT_3_HOST=192.168.7.249
UBNT_3_USER=ubnt
UBNT_3_PASSWORD=
UBNT_3_NAME=AP 3

# ──────────────────────────────────────────
# Multi-ISP WAN Connectivity
# ──────────────────────────────────────────
# Format: ISP{N}_NAME, ISP{N}_INTERFACE (up to 10 ISPs)
ISP1_NAME=IPLAN
ISP1_INTERFACE=ether10IPLAN

ISP2_NAME=Fibertel
ISP2_INTERFACE=ether9FIBER

# ──────────────────────────────────────────
# Webex Bot Notifications
# ──────────────────────────────────────────
WEBEX_BOT_TOKEN=
WEBEX_ROOM_IT_ID=
WEBEX_ROOM_TEST_ID=
WEBEX_ROOM_DEFAULT=it

